#%RAML 1.0
title: wco-sapi-rest
protocols:
  - HTTP
  - HTTPS
version: v1


traits:
  Client-ID-Policy: !include /exchange-module-v1/clientID-enforcement-trait.raml

/user:
  get:
    is: [Client-ID-Policy]
    queryParameters:
      page:
        type: number
        required: true
    responses:
      200:
        body:
          application/json:
            example: !include /examples/user-details-by-page-response-file.json
          